#################################################################
#    Classes
#################################################################

###  http://www.example.com/semanticMeasurements#Consumer
:Consumer rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty :owns ;
                                owl:someValuesFrom :Meter
                              ] ;
          owl:disjointWith :Device ,
                           :Measurement .


###  http://www.example.com/semanticMeasurements#Device
:Device rdf:type owl:Class ;
        owl:equivalentClass [ rdf:type owl:Restriction ;
                              owl:onProperty :id ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ;
        owl:disjointWith :Measurement ;
        owl:hasKey ( :id
                   ) .


###  http://www.example.com/semanticMeasurements#EnergyMeasurement
:EnergyMeasurement rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty :measuredBy ;
                                         owl:allValuesFrom :EnergyMeter
                                       ] ;
                   rdfs:subClassOf :Measurement ;
                   owl:disjointWith :WaterMeasurement .


###  http://www.example.com/semanticMeasurements#EnergyMeter
:EnergyMeter rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty :emits ;
                                   owl:allValuesFrom :EnergyMeasurement
                                 ] ;
             rdfs:subClassOf :Meter .


###  http://www.example.com/semanticMeasurements#Gateway
:Gateway rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Restriction ;
                               owl:onProperty :receivesFrom ;
                               owl:someValuesFrom :Meter
                             ] ;
         rdfs:subClassOf :Device ;
         owl:disjointWith :Meter .


###  http://www.example.com/semanticMeasurements#Hommie
:Hommie rdf:type owl:Class ;
        rdfs:subClassOf :Consumer ;
        owl:disjointWith :Scammer .


###  http://www.example.com/semanticMeasurements#InvalidMeasurement
:InvalidMeasurement rdf:type owl:Class ;
                    rdfs:subClassOf :Measurement ;
                    owl:disjointWith :ValidMeasurement .


###  http://www.example.com/semanticMeasurements#Measurement
:Measurement rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty :measuredBy ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Meter
                                 ] .


###  http://www.example.com/semanticMeasurements#Meter
:Meter rdf:type owl:Class ;
       owl:equivalentClass [ rdf:type owl:Restriction ;
                             owl:onProperty :emits ;
                             owl:someValuesFrom :Measurement
                           ] ;
       rdfs:subClassOf :Device .


###  http://www.example.com/semanticMeasurements#Scammer
:Scammer rdf:type owl:Class ;
         rdfs:subClassOf :Consumer .


###  http://www.example.com/semanticMeasurements#ValidMeasurement
:ValidMeasurement rdf:type owl:Class ;
                  rdfs:subClassOf :Measurement .


###  http://www.example.com/semanticMeasurements#WaterMeasurement
:WaterMeasurement rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty :measuredBy ;
                                        owl:allValuesFrom :WaterMeter
                                      ] ;
                  rdfs:subClassOf :Measurement .


###  http://www.example.com/semanticMeasurements#WaterMeter
:WaterMeter rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty :emits ;
                                  owl:allValuesFrom :WaterMeasurement
                                ] ;
            rdfs:subClassOf :Meter .


