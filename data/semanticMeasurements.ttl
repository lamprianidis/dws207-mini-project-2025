:reverse_flow rdf:type owl:DatatypeProperty ;
              rdfs:domain :Measurement ;
              rdfs:range xsd:integer .


###  http://www.example.com/semanticMeasurements#routelist_id
:routelist_id rdf:type owl:DatatypeProperty ;
              rdfs:domain :Measurement ;
              rdfs:range xsd:string .


