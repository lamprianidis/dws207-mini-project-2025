@prefix : <http://www.example.com/semanticMeasurements#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.example.com/semanticMeasurements#> .

<http://example.com/semanticMeasurements> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.example.com/semanticMeasurements#emits
:emits rdf:type owl:ObjectProperty ;
       owl:inverseOf :measuredBy ;
       rdfs:domain :Meter ;
       rdfs:range :Measurement .


###  http://www.example.com/semanticMeasurements#measuredBy
:measuredBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Measurement ;
            rdfs:range :Meter .


###  http://www.example.com/semanticMeasurements#ownedBy
:ownedBy rdf:type owl:ObjectProperty ;
         owl:inverseOf :owns ;
         rdfs:domain :Meter ;
         rdfs:range :Consumer .


###  http://www.example.com/semanticMeasurements#owns
:owns rdf:type owl:ObjectProperty ;
      rdfs:domain :Consumer ;
      rdfs:range :Meter .


###  http://www.example.com/semanticMeasurements#received
:received rdf:type owl:ObjectProperty ;
          owl:inverseOf :receivedBy ;
          rdfs:domain :Gateway ;
          rdfs:range :Measurement .


###  http://www.example.com/semanticMeasurements#receivedBy
:receivedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Measurement ;
            rdfs:range :Gateway .


###  http://www.example.com/semanticMeasurements#receivesFrom
:receivesFrom rdf:type owl:ObjectProperty ;
              rdfs:domain :Gateway ;
              rdfs:range :Meter .


#################################################################
#    Data properties
#################################################################

###  http://www.example.com/semanticMeasurements#burst
:burst rdf:type owl:DatatypeProperty ;
       rdfs:domain :Measurement ;
       rdfs:range xsd:integer .


###  http://www.example.com/semanticMeasurements#client_id
:client_id rdf:type owl:DatatypeProperty ;
           rdfs:domain :Meter ;
           rdfs:range xsd:string .


###  http://www.example.com/semanticMeasurements#code
:code rdf:type owl:DatatypeProperty ;
      rdfs:domain :Meter ;
      rdfs:range xsd:string .


###  http://www.example.com/semanticMeasurements#consumption
:consumption rdf:type owl:DatatypeProperty ;
             rdfs:domain :Measurement ;
             rdfs:range xsd:integer .


###  http://www.example.com/semanticMeasurements#created_at
:created_at rdf:type owl:DatatypeProperty ;
            rdfs:domain :Meter ;
            rdfs:range xsd:dateTime .


###  http://www.example.com/semanticMeasurements#date
:date rdf:type owl:DatatypeProperty ;
      rdfs:domain :Meter ;
      rdfs:range xsd:dateTime .


###  http://www.example.com/semanticMeasurements#diameter
:diameter rdf:type owl:DatatypeProperty ;
          rdfs:domain :Meter ;
          rdfs:range xsd:string .


###  http://www.example.com/semanticMeasurements#empty_spool
:empty_spool rdf:type owl:DatatypeProperty ;
             rdfs:domain :Measurement ;
             rdfs:range xsd:integer .


###  http://www.example.com/semanticMeasurements#encryption_protocol
:encryption_protocol rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Meter ;
                     rdfs:range xsd:string .


###  http://www.example.com/semanticMeasurements#freeze
:freeze rdf:type owl:DatatypeProperty ;
        rdfs:domain :Measurement ;
        rdfs:range xsd:integer .


###  http://www.example.com/semanticMeasurements#gateway_id
:gateway_id rdf:type owl:DatatypeProperty ;
            rdfs:domain :Measurement ;
            rdfs:range xsd:string .


###  http://www.example.com/semanticMeasurements#hardware
:hardware rdf:type owl:DatatypeProperty ;
          rdfs:domain :Measurement ;
          rdfs:range xsd:integer .


###  http://www.example.com/semanticMeasurements#id
:id rdf:type owl:DatatypeProperty ,
             owl:FunctionalProperty ;
    rdfs:domain :Device ;
    rdfs:range xsd:string .


###  http://www.example.com/semanticMeasurements#leakage
:leakage rdf:type owl:DatatypeProperty ;
         rdfs:domain :Measurement ;
         rdfs:range xsd:integer .


###  http://www.example.com/semanticMeasurements#length
:length rdf:type owl:DatatypeProperty ;
        rdfs:domain :Meter ;
        rdfs:range xsd:string .


###  http://www.example.com/semanticMeasurements#manufacturer
:manufacturer rdf:type owl:DatatypeProperty ;
              rdfs:domain :Meter ;
              rdfs:range xsd:string .


###  http://www.example.com/semanticMeasurements#meter_address
:meter_address rdf:type owl:DatatypeProperty ;
               rdfs:domain :Measurement ;
               rdfs:range xsd:string .


###  http://www.example.com/semanticMeasurements#model
:model rdf:type owl:DatatypeProperty ;
       rdfs:domain :Meter ;
       rdfs:range xsd:string .


###  http://www.example.com/semanticMeasurements#power_low
:power_low rdf:type owl:DatatypeProperty ;
           rdfs:domain :Measurement ;
